rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'roles', 'isAdmin', 'isReviewer', 'xp', 'is_premium'
        ])
        && (!('isPro' in request.resource.data) || request.resource.data.isPro == false)
        && (!('isUltimate' in request.resource.data) || request.resource.data.isUltimate == false)
        && !('expiryDate' in request.resource.data)
        && !('xp' in request.resource.data)
        && !('streak' in request.resource.data)
        && !('maxStreak' in request.resource.data)
        && !('lastActive' in request.resource.data)
        && !('dailyQuizStreak' in request.resource.data)
        && !('lastDailyQuizDate' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'roles', 'isAdmin', 'isReviewer', 'xp', 'is_premium'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'email', 'phoneNumber', 'class', 'board',
          'photoUrl', 'badges', 'examDate', 'dailyGoal', 'createdAt',
          'updatedAt', 'referralCode', 'referredBy'
        ]);
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId}/studyProgress/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/studyPlans/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/studyPlan/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/chatHistory/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /content/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /userProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /quizResults/{document=**} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /{subcollection}/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId
          && subcollection in ['dailyQuizzes', 'daily', 'paperHistory', 'studySessions'];
      }
    }

    match /chatHistory/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isUltimate == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dailyAiCount < 5);
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /studyPlans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /mockTests/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /study_materials/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /pyqs/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /referrals/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /dailyQuiz/{quizId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /review_queue/{document=**} {
      allow read, write: if false;
    }

    match /reviewQueue/{document=**} {
      allow read, write: if false;
    }

    match /orders/{document=**} {
      allow read, write: if false;
    }

    match /paymentOrders/{document=**} {
      allow read, write: if false;
    }

    match /premiumPurchases/{purchaseId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /premiumContent/{document=**} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isUltimate == true)
        && (!('expiryDate' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.expiryDate > request.time);
      allow write: if false;
    }
  }
}
